{
  "name": "@aidi/node",
  "version": "0.1.0",
  "private": false,
  "description": "Official AIDI SDK for Node.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidi-sdk/aidi-sdk.git"
  },
  "homepage": "https://github.com/aidi-sdk/aidi-sdk#readme",
  "bugs": {
    "url": "https://github.com/aidi-sdk/aidi-sdk/issues"
  },
  "keywords": [
    "aidi",
    "sdk",
    "node",
    "typescript",
    "identity",
    "verification"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run build && npm run pack:check",
    "prepack": "npm run build",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true}); require('node:fs').rmSync('coverage',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
